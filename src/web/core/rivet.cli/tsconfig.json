{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "cli/**/*.js"]
}
