{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
    "productName": "Rivet",
    "version": "0.1.0",
    "identifier": "com.rivet.devapp",
    "build": {
        "frontendDist": "../web/apps/stress-test/dist",
        "devUrl": "http://localhost:9720",
        "beforeDevCommand": "",
        "beforeBuildCommand": ""
    },
    "app": {
        "windows": [
            {
                "title": "Rivet",
                "width": 1280,
                "height": 800,
                "center": true,
                "theme": "Light"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
