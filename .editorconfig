root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[src/**]
indent_style = space
indent_size = 4
tab_width = 4

[src/web/**/*.js]
max_line_length = 160

[src/web/**/*.ts]
max_line_length = 160

[src/web/**/*.vue]
max_line_length = 160

[*.md]
trim_trailing_whitespace = false
